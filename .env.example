# Vitae.ai Environment Variables
# Copy this file to .env.local and fill in your values

# Required: Groq API Key for AI features
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Your GitHub username for repository integration
# Used to fetch and display your public repositories
NEXT_PUBLIC_GITHUB_USERNAME=your_github_username

# App mode: "personal" (default) or "demo"
NEXT_PUBLIC_APP_MODE=personal

# Optional: External demo URL for the public preview project
NEXT_PUBLIC_DEMO_URL=https://your-demo.vercel.app

# Optional: Personal CV URL for demo mode navigation
NEXT_PUBLIC_PERSONAL_URL=https://your-personal-cv.vercel.app
